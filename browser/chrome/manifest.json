{
  "manifest_version": 3,
  "name": "ARRA Oracles — Issue to Nexus",
  "version": "26.10.7.836",
  "description": "Right-click a page, link, image or selection — or the 🔮 Nexus button on a Facebook post: Nexus opens the issue draft.",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "version_name": "v26.10.7-alpha.836",
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "fb.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:4747/*",
    "https://www.facebook.com/*"
  ],
  "action": {
    "default_title": "ARRA Oracles — bridge: checking…",
    "default_icon": {
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  }
}
