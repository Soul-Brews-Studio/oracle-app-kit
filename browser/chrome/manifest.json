{
  "manifest_version": 3,
  "name": "ARRA Oracles — New issue in",
  "version": "26.10.7.708",
  "description": "Right-click a page, link, image or selection — or the 🔮 Issue button on a Facebook post: New issue in ▸ an oracle; its Mac app opens the draft.",
  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "version_name": "v26.10.7-alpha.708",
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "fb.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
