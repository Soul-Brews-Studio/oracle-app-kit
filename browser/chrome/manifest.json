{
  "manifest_version": 3,
  "name": "ARRA Oracles — Issue to Nexus",
  "version": "26.10.7.804",
  "description": "Right-click a page, link, image or selection — or the 🔮 Nexus button on a Facebook post: Nexus opens the issue draft.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "version_name": "v26.10.7-alpha.804",
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "fb.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ]
}
